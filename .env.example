# The Odds API — free tier key from https://the-odds-api.com/
ODDS_API_KEY=your_api_key_here

# Postgres connection string (required)
# Neon example: postgresql://user:pass@ep-xxx.us-east-2.aws.neon.tech/sportarbitrage?sslmode=require
DATABASE_URL=postgresql://localhost:5432/sportarbitrage

# Optional: Discord webhook for arb alerts (free)
# DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/...

# Enable/disable alert dispatch (default: true)
# ENABLE_ALERTS=true

# Minimum arbitrage margin to report (default: 0.01 = 1%)
# MIN_ARB_MARGIN=0.01

# Maximum age (seconds) for bookmaker odds to be considered fresh (default: 300)
# MAX_ODDS_AGE_SECONDS=300

# Default total stake for profit calculations (default: 100)
# DEFAULT_STAKE=100

# Comma-separated sport keys to scan
# TARGET_SPORTS=basketball_nba,baseball_mlb,americanfootball_nfl,icehockey_nhl

# Optional: Telegram alerts (free via Bot API)
# TELEGRAM_BOT_TOKEN=123456:ABC-DEF1234ghIkl-zyx57W2v1u123ew11
# TELEGRAM_CHAT_ID=-1001234567890
